[Unit]
Description=vmuc guest agent
Documentation=https://github.com/giejqf/vmuc
# The agent needs local disks and vsock, nothing else, and is installed
# from cloud-init's bootcmd (inside cloud-init.service, which is ordered
# before sysinit.target): default dependencies would hold it back until
# cloud-init finished, and `vmuc start` waits for it.
DefaultDependencies=no
After=local-fs.target
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=simple
ExecStart=/usr/local/bin/vmuc-agent
Restart=always
RestartSec=1
User=root

[Install]
WantedBy=multi-user.target
