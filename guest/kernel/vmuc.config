# SPDX-License-Identifier: Apache-2.0
#
# vmuc guest kernel: kconfig fragment merged onto arch/arm64 defconfig by
# guest/kernel/build.sh (scripts/kconfig/merge_config.sh). Disables are
# written as "# CONFIG_X is not set" so merge_config.sh can verify them.
#
# Remember that with CONFIG_MODULES=n every "=m" in defconfig becomes
# "=y"; that is why whole subsystems are switched off below instead of
# relying on defconfig leaving them as modules.

# --- Identity -------------------------------------------------------------
CONFIG_LOCALVERSION="-vmuc"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DEFAULT_HOSTNAME="vmuc"
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# --- No modules: everything the VMM can present is built in ---------------
# CONFIG_MODULES is not set

# --- Platform: one machine, described by device tree ----------------------
# vmuc's VMM (and QEMU -M virt in the test harness) is a flat GICv3 +
# arch-timer + PL011 + PL031 + virtio-mmio machine. No SoC support, no
# ACPI, no PCI, no EFI stub: the VMM loads Image directly.
# CONFIG_ACPI is not set
# CONFIG_PCI is not set
# CONFIG_EFI is not set
# CONFIG_ARCH_ACTIONS is not set
# CONFIG_ARCH_AIROHA is not set
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_ALPINE is not set
# CONFIG_ARCH_APPLE is not set
# CONFIG_ARCH_ARTPEC is not set
# CONFIG_ARCH_AXIADO is not set
# CONFIG_ARCH_BCM is not set
# CONFIG_ARCH_BCM2835 is not set
# CONFIG_ARCH_BCM_IPROC is not set
# CONFIG_ARCH_BCMBCA is not set
# CONFIG_ARCH_BRCMSTB is not set
# CONFIG_ARCH_BERLIN is not set
# CONFIG_ARCH_BLAIZE is not set
# CONFIG_ARCH_CIX is not set
# CONFIG_ARCH_EXYNOS is not set
# CONFIG_ARCH_SPARX5 is not set
# CONFIG_ARCH_K3 is not set
# CONFIG_ARCH_LG1K is not set
# CONFIG_ARCH_HISI is not set
# CONFIG_ARCH_KEEMBAY is not set
# CONFIG_ARCH_MEDIATEK is not set
# CONFIG_ARCH_MESON is not set
# CONFIG_ARCH_MVEBU is not set
# CONFIG_ARCH_NXP is not set
# CONFIG_ARCH_LAYERSCAPE is not set
# CONFIG_ARCH_MXC is not set
# CONFIG_ARCH_S32 is not set
# CONFIG_ARCH_MA35 is not set
# CONFIG_ARCH_NPCM is not set
# CONFIG_ARCH_QCOM is not set
# CONFIG_ARCH_REALTEK is not set
# CONFIG_ARCH_RENESAS is not set
# CONFIG_ARCH_ROCKCHIP is not set
# CONFIG_ARCH_SEATTLE is not set
# CONFIG_ARCH_INTEL_SOCFPGA is not set
# CONFIG_ARCH_SOPHGO is not set
# CONFIG_ARCH_STM32 is not set
# CONFIG_ARCH_SYNQUACER is not set
# CONFIG_ARCH_TEGRA is not set
# CONFIG_ARCH_TESLA_FSD is not set
# CONFIG_ARCH_SPRD is not set
# CONFIG_ARCH_THUNDER is not set
# CONFIG_ARCH_THUNDER2 is not set
# CONFIG_ARCH_UNIPHIER is not set
# CONFIG_ARCH_VEXPRESS is not set
# CONFIG_ARCH_VISCONTI is not set
# CONFIG_ARCH_XGENE is not set
# CONFIG_ARCH_ZYNQMP is not set
# Firmware interfaces other than PSCI
CONFIG_ARM_PSCI_FW=y
# CONFIG_ARM_SCMI_PROTOCOL is not set
# CONFIG_ARM_SCPI_PROTOCOL is not set
# CONFIG_ARM_SDE_INTERFACE is not set
# CONFIG_ARM_FFA_TRANSPORT is not set
# CONFIG_TEE is not set
# CONFIG_EFI_CAPSULE_LOADER is not set
# CONFIG_EFIVAR_FS is not set

# --- CPU: SMP via PSCI, 4 KiB pages, 48-bit VA, HZ=250, tickless idle -------
CONFIG_SMP=y
CONFIG_NR_CPUS=64
CONFIG_HOTPLUG_CPU=y
CONFIG_ARM64_4K_PAGES=y
CONFIG_ARM64_VA_BITS_48=y
CONFIG_HZ_250=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
# NUMA and 32-bit compat have no use on an Apple-silicon guest (the cores
# have no AArch32 EL0).
# CONFIG_NUMA is not set
# CONFIG_NUMA_BALANCING is not set
# CONFIG_COMPAT is not set
# Idle is plain WFI trapped by the VMM; no cpuidle/cpufreq governors.
# CONFIG_CPU_IDLE is not set
# CONFIG_ARM_PSCI_CPUIDLE is not set
# CONFIG_CPU_FREQ is not set
# CONFIG_ARM_SCMI_CPUFREQ is not set
# Not a hypervisor host, not a Xen/KVM paravirt guest.
# CONFIG_VIRTUALIZATION is not set
# CONFIG_KVM is not set
# CONFIG_XEN is not set
# CONFIG_PARAVIRT is not set
# CONFIG_PARAVIRT_TIME_ACCOUNTING is not set
# CONFIG_HIBERNATION is not set
# CONFIG_SUSPEND is not set
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set
# CONFIG_CRASH_DUMP is not set
# CONFIG_CORESIGHT is not set
# CONFIG_ARM64_PSEUDO_NMI is not set
# CONFIG_PROFILING is not set
# The VMM supplies rng-seed in the FDT; the kernel trusts it by default
# (CONFIG_RANDOM_TRUST_BOOTLOADER was removed in 6.2, now random.trust_bootloader=1).
CONFIG_CMDLINE=""
# CONFIG_CMDLINE_FORCE is not set

# --- Memory: the product. Pages the guest frees must reach the host. -------
# PAGE_REPORTING + VIRTIO_BALLOON is the bulk return path; THP keeps
# pageblock order at 9 so reports are 2 MiB runs; the two "init/poison"
# options would re-dirty pages the guest is about to report, so they stay
# off (AGENTS.md invariant). No CMA: it would reserve RAM for DMA nobody needs.
CONFIG_PAGE_REPORTING=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_BALLOON_COMPACTION=y
CONFIG_COMPACTION=y
CONFIG_MIGRATION=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
# CONFIG_INIT_ON_FREE_DEFAULT_ON is not set
# CONFIG_INIT_ON_ALLOC_DEFAULT_ON is not set
# CONFIG_PAGE_POISONING is not set
# CONFIG_CMA is not set
# CONFIG_DMA_CMA is not set
# CONFIG_KSM is not set
# CONFIG_MEMORY_FAILURE is not set
# CONFIG_ZSWAP is not set
# CONFIG_ZRAM is not set
CONFIG_SWAP=y
CONFIG_MEMCG=y
CONFIG_PSI=y
# CONFIG_PSI_DEFAULT_DISABLED is not set
CONFIG_USERFAULTFD=y
# FUSE_DAX (virtiofs DAX window) needs FS_DAX -> ZONE_DEVICE -> hotplug.
CONFIG_MEMORY_HOTPLUG=y
CONFIG_MEMORY_HOTREMOVE=y
CONFIG_ZONE_DEVICE=y
CONFIG_DAX=y
CONFIG_FS_DAX=y

# --- Console, RTC, random --------------------------------------------------
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
# CONFIG_SERIAL_8250 is not set
# CONFIG_SERIAL_OF_PLATFORM is not set
# CONFIG_SERIAL_DEV_BUS is not set
CONFIG_VIRTIO_CONSOLE=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_DRV_PL031=y
# CONFIG_RTC_NVMEM is not set
# CONFIG_RTC_DRV_EFI is not set
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
# CONFIG_HW_RANDOM_ARM_SMCCC_TRNG is not set
# CONFIG_HW_RANDOM_CCTRNG is not set
CONFIG_PRINTK_TIME=y
# No virtual terminal / input layer: the console is serial or hvc only.
# (VT is only switchable with EXPERT; the core syscalls EXPERT exposes are
# pinned on below so a default change upstream cannot silently drop them.)
CONFIG_EXPERT=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_ELF_CORE=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_IO_URING=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_KALLSYMS=y
CONFIG_MULTIUSER=y
CONFIG_SGETMASK_SYSCALL=y
CONFIG_SYSFS_SYSCALL=y
CONFIG_FHANDLE=y
CONFIG_POSIX_TIMERS=y
CONFIG_RSEQ=y
CONFIG_PERF_EVENTS=y
CONFIG_BPF_SYSCALL=y
CONFIG_KCMP=y
CONFIG_NET_INGRESS=y
CONFIG_NET_EGRESS=y
CONFIG_INET_DIAG_DESTROY=y
CONFIG_DNOTIFY=y
CONFIG_INOTIFY_USER=y
CONFIG_DEVMEM=y
CONFIG_DEVPORT=y
# CONFIG_VT is not set
# CONFIG_INPUT is not set
# CONFIG_HID_SUPPORT is not set
# CONFIG_LEGACY_PTYS is not set
CONFIG_UNIX98_PTYS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# --- virtio over MMIO only -------------------------------------------------
# vmuc's transport is virtio-mmio v2; the cmdline parser lets the VMM or
# a test add devices with virtio_mmio.device=. No PCI, no vhost, no 9p.
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
# CONFIG_VIRTIO_PCI is not set
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VSOCKETS=y
CONFIG_VSOCKETS_DIAG=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_VIRTIO_FS=y
CONFIG_FUSE_FS=y
CONFIG_FUSE_DAX=y
# CONFIG_VIRTIO_INPUT is not set
# CONFIG_VIRTIO_IOMMU is not set
# CONFIG_VIRTIO_MEM is not set
# CONFIG_VIRTIO_PMEM is not set
# CONFIG_VHOST_MENU is not set
# CONFIG_NET_9P is not set
# CONFIG_9P_FS is not set

# --- Block, device mapper, initramfs -----------------------------------------
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_XZ=y
CONFIG_RD_ZSTD=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_LOOP_MIN_COUNT=8
# CONFIG_BLK_DEV_NBD is not set
# CONFIG_BLK_DEV_RAM is not set
# CONFIG_BLK_DEV_NVME is not set
CONFIG_MD=y
# CONFIG_BLK_DEV_MD is not set
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
CONFIG_DM_VERITY=y
CONFIG_DM_SNAPSHOT=y
CONFIG_DM_THIN_PROVISIONING=y
CONFIG_DM_ZERO=y
# CONFIG_DM_MIRROR is not set
CONFIG_BLK_CGROUP=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_IOSCHED_BFQ=y
CONFIG_BFQ_GROUP_IOSCHED=y
CONFIG_MQ_IOSCHED_KYBER=y
CONFIG_BLK_DEV_WRITE_MOUNTED=y
# No physical storage buses.
# CONFIG_SCSI is not set
# CONFIG_ATA is not set
# CONFIG_MMC is not set
# CONFIG_MTD is not set
# CONFIG_NVMEM is not set
# CONFIG_MEMSTICK is not set

# --- Filesystems -------------------------------------------------------------
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_XFS_FS=y
CONFIG_XFS_QUOTA=y
CONFIG_XFS_POSIX_ACL=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_ZIP_LZMA=y
CONFIG_EROFS_FS_ZIP_ZSTD=y
CONFIG_OVERLAY_FS=y
CONFIG_OVERLAY_FS_REDIRECT_DIR=y
CONFIG_OVERLAY_FS_INDEX=y
CONFIG_OVERLAY_FS_XINO_AUTO=y
CONFIG_OVERLAY_FS_METACOPY=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_ZISOFS=y
CONFIG_MSDOS_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_NLS=y
CONFIG_NLS_DEFAULT="utf8"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_FILE_DIRECT=y
CONFIG_SQUASHFS_COMPILE_DECOMP_MULTI_PERCPU=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_PROC_FS=y
CONFIG_PROC_KCORE=y
CONFIG_SYSFS=y
CONFIG_CONFIGFS_FS=y
CONFIG_AUTOFS_FS=y
CONFIG_FANOTIFY=y
CONFIG_FANOTIFY_ACCESS_PERMISSIONS=y
CONFIG_QUOTA=y
CONFIG_QUOTA_NETLINK_INTERFACE=y
CONFIG_QFMT_V2=y
CONFIG_FS_POSIX_ACL=y
CONFIG_BINFMT_MISC=y
CONFIG_BINFMT_SCRIPT=y
# NFS client (no server), v3/v4.x, over TCP.
CONFIG_NFS_FS=y
CONFIG_NFS_V3=y
CONFIG_NFS_V3_ACL=y
CONFIG_NFS_V4=y
CONFIG_NFS_V4_1=y
CONFIG_NFS_V4_2=y
# CONFIG_NFSD is not set
# CONFIG_CIFS is not set
# CONFIG_CEPH_FS is not set
# CONFIG_F2FS_FS is not set
CONFIG_HUGETLBFS=y
# CONFIG_PSTORE is not set

# --- cgroups v2, namespaces, seccomp, LSM hooks ----------------------------
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_RT_GROUP_SCHED=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_MISC=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_CGROUP_NET_CLASSID=y
# CONFIG_CGROUP_RDMA is not set
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_TIME_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_KEYS=y
CONFIG_POSIX_MQUEUE=y
CONFIG_SYSVIPC=y
CONFIG_AUDIT=y

# --- BPF, BTF, tracing: the agent's sys_exit_bind tracepoint needs ---------
# BPF_SYSCALL + syscall tracepoints (FTRACE_SYSCALLS) + BPF_EVENTS. BTF is
# needed for CO-RE and costs DWARF at build time only: DEBUG_INFO_NONE
# cannot be set together with BTF, so DWARF is generated and the Image
# (objcopy of vmlinux) carries only the .BTF section, not the DWARF.
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_UNPRIV_DEFAULT_OFF=y
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
# CONFIG_DEBUG_INFO_NONE is not set
# CONFIG_DEBUG_INFO_REDUCED is not set
# CONFIG_DEBUG_INFO_SPLIT is not set
CONFIG_DEBUG_INFO_BTF=y
CONFIG_PERF_EVENTS=y
CONFIG_FTRACE=y
CONFIG_TRACEPOINTS=y
CONFIG_FTRACE_SYSCALLS=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_UPROBE_EVENTS=y
CONFIG_BPF_EVENTS=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_NET_SOCK_MSG=y
CONFIG_BPF_STREAM_PARSER=y
CONFIG_XDP_SOCKETS=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_ACT_BPF=y
CONFIG_NETFILTER_XT_MATCH_BPF=y
# CONFIG_DEBUG_PREEMPT is not set

# --- Networking core ----------------------------------------------------------
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_PACKET_DIAG=y
CONFIG_UNIX=y
CONFIG_UNIX_DIAG=y
CONFIG_INET=y
CONFIG_INET_DIAG=y
CONFIG_INET_UDP_DIAG=y
CONFIG_INET_RAW_DIAG=y
CONFIG_NETLINK_DIAG=y
CONFIG_IP_MULTICAST=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_XFRM_USER=y
CONFIG_INET_ESP=y
CONFIG_INET6_ESP=y
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_TCP_CONG_BBR=y
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_CLS_CGROUP=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ_CODEL=y
CONFIG_VLAN_8021Q=y
# CONFIG_VLAN_8021Q_GVRP is not set
# CONFIG_VLAN_8021Q_MVRP is not set
CONFIG_BRIDGE=y
CONFIG_BRIDGE_VLAN_FILTERING=y
CONFIG_BRIDGE_IGMP_SNOOPING=y
# Container / Docker virtual NICs.
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VETH=y
CONFIG_MACVLAN=y
CONFIG_IPVLAN=y
CONFIG_TUN=y
CONFIG_DUMMY=y
CONFIG_VXLAN=y
CONFIG_WIREGUARD=y
# No physical NICs, PHYs, wireless or bluetooth.
# CONFIG_ETHERNET is not set
# CONFIG_NET_DSA is not set
# CONFIG_PHYLIB is not set
# CONFIG_WLAN is not set
# CONFIG_WIRELESS is not set
# CONFIG_CFG80211 is not set
# CONFIG_MAC80211 is not set
# CONFIG_BT is not set
# CONFIG_NFC is not set
# CONFIG_RFKILL is not set
# CONFIG_CAN is not set
# CONFIG_NET_VENDOR_INTEL is not set

